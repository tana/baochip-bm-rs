        <register>
          <name>MSLEEP_TARGET0</name>
          <description>Bits 0-31 of `TICKTIMER_MSLEEP_TARGET`.</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>msleep_target</name>
              <bitRange>[31:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>EV_STATUS</name>
          <description>This register contains the current raw level of the alarm event trigger.  Writes
to this register have no effect.</description>
          <addressOffset>0x14</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>alarm</name>
              <description>Level of the ``alarm`` event</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>EV_PENDING</name>
          <description>When a  alarm event occurs, the corresponding bit will be set in this register.
To clear the Event, set the corresponding bit in this register.</description>
          <addressOffset>0x18</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>alarm</name>
              <description>`1` if a `alarm` event occurred. This Event is **level triggered** when the
signal is **high**.</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>EV_ENABLE</name>
          <description>This register enables the corresponding alarm events.  Write a ``0`` to this
register to disable individual events.</description>
          <addressOffset>0x1C</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>alarm</name>
              <description>Write a ``1`` to enable the ``alarm`` Event</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>CLOCKS_PER_TICK</name>
          <description>Clocks per tick, defaults to 800000</description>
          <addressOffset>0x20</addressOffset>
          <size>0x20</size>
          <resetValue>0x000C3500</resetValue>
          <fields>
            <field>
              <name>clocks_per_tick</name>
              <bitRange>[31:0]</bitRange>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TIMER0</name>
      <groupName>TIMER0</groupName>
      <baseAddress>0xE001C000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x20</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>timer0</name>
        <value>30</value>
      </interrupt>
      <registers>
        <register>
          <name>LOAD</name>
          <description>Load value when Timer is (re-)enabled. In One-Shot mode, the value written to
this register specifies the Timer's duration in clock cycles.</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>load</name>
              <bitRange>[31:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>RELOAD</name>
          <description>Reload value when Timer reaches ``0``. In Periodic mode, the value written to
this register specify the Timer's period in clock cycles.</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>reload</name>
              <bitRange>[31:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>EN</name>
          <description>Enable flag of the Timer. Set this flag to ``1`` to enable/start the Timer.  Set
to ``0`` to disable the Timer.</description>
          <addressOffset>0x8</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>en</name>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>UPDATE_VALUE</name>
          <description>Update trigger for the current countdown value. A write to this register latches
the current countdown value to ``value`` register.</description>
          <addressOffset>0xC</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>update_value</name>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>VALUE</name>
          <description>Latched countdown value. This value is updated by writing to ``update_value``.</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>value</name>
              <bitRange>[31:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>EV_STATUS</name>
          <description>This register contains the current raw level of the zero event trigger.  Writes
to this register have no effect.</description>
          <addressOffset>0x14</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>zero</name>
              <description>Level of the ``zero`` event</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>EV_PENDING</name>
          <description>When a  zero event occurs, the corresponding bit will be set in this register.
To clear the Event, set the corresponding bit in this register.</description>
          <addressOffset>0x18</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>zero</name>
              <description>`1` if a `zero` event occurred. This Event is triggered on a **falling** edge.</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>EV_ENABLE</name>
          <description>This register enables the corresponding zero events.  Write a ``0`` to this
register to disable individual events.</description>
          <addressOffset>0x1C</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>zero</name>
              <description>Write a ``1`` to enable the ``zero`` Event</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>