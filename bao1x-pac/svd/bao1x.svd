    <peripheral>
      <name>MAILBOX</name>
      <groupName>MAILBOX</groupName>
      <baseAddress>0xE0018000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x24</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>mailbox</name>
        <value>22</value>
      </interrupt>
      <registers>
        <register>
          <name>WDATA</name>
          <description>Write data to outgoing FIFO.</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>wdata</name>
              <bitRange>[31:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>RDATA</name>
          <description>Read data from incoming FIFO.</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>rdata</name>
              <bitRange>[31:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>EV_STATUS</name>
          <description>Triggers if either `tx_err` or `rx_err` are asserted</description>
          <addressOffset>0x8</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>available</name>
              <description>Level of the ``available`` event</description>
              <bitRange>[0:0]</bitRange>
            </field>
            <field>
              <name>abort_init</name>
              <description>Level of the ``abort_init`` event</description>
              <bitRange>[1:1]</bitRange>
            </field>
            <field>
              <name>abort_done</name>
              <description>Level of the ``abort_done`` event</description>
              <bitRange>[2:2]</bitRange>
            </field>
            <field>
              <name>error</name>
              <description>Level of the ``error`` event</description>
              <bitRange>[3:3]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>EV_PENDING</name>
          <description>Triggers if either `tx_err` or `rx_err` are asserted</description>
          <addressOffset>0xC</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>available</name>
              <description>Triggers when the `done` signal was asserted by the corresponding peer</description>
              <bitRange>[0:0]</bitRange>
            </field>
            <field>
              <name>abort_init</name>
              <description>Triggers when abort is asserted by the peer, and there is currently no abort in
progress</description>
              <bitRange>[1:1]</bitRange>
            </field>
            <field>
              <name>abort_done</name>
              <description>Triggers when a previously initiated abort is acknowledged by peer</description>
              <bitRange>[2:2]</bitRange>
            </field>
            <field>
              <name>error</name>
              <description>Triggers if either `tx_err` or `rx_err` are asserted</description>
              <bitRange>[3:3]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>EV_ENABLE</name>
          <description>Triggers if either `tx_err` or `rx_err` are asserted</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>available</name>
              <description>Write a ``1`` to enable the ``available`` Event</description>
              <bitRange>[0:0]</bitRange>
            </field>
            <field>
              <name>abort_init</name>
              <description>Write a ``1`` to enable the ``abort_init`` Event</description>
              <bitRange>[1:1]</bitRange>
            </field>
            <field>
              <name>abort_done</name>
              <description>Write a ``1`` to enable the ``abort_done`` Event</description>
              <bitRange>[2:2]</bitRange>
            </field>
            <field>
              <name>error</name>
              <description>Write a ``1`` to enable the ``error`` Event</description>
              <bitRange>[3:3]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>STATUS</name>
          <addressOffset>0x14</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>rx_words</name>
              <description>Number of words available to read</description>
              <bitRange>[10:0]</bitRange>
            </field>
            <field>
              <name>tx_words</name>
              <description>Number of words pending in write FIFO. Free space is 1024 - `tx_avail`</description>
              <bitRange>[21:11]</bitRange>
            </field>
            <field>
              <name>abort_in_progress</name>
              <description>This bit is set if an `aborting` event was initiated and is still in progress.</description>
              <bitRange>[22:22]</bitRange>
            </field>
            <field>
              <name>abort_ack</name>
              <description>This bit is set by the peer that acknowledged the incoming abort (the later of
the two, in case of an imperfect race condition). The abort response handler
should check this bit; if it is set, no new acknowledgement shall be issued. The
bit is cleared when an initiator initiates a new abort. The initiator shall also
ignore the state of this bit if it is intending to initiate a new abort cycle.</description>
              <bitRange>[23:23]</bitRange>
            </field>
            <field>
              <name>tx_err</name>
              <description>Set if the write FIFO overflowed because we wrote too much data. Cleared on
register read.</description>
              <bitRange>[24:24]</bitRange>
            </field>
            <field>
              <name>rx_err</name>
              <description>Set if read FIFO underflowed because we read too much data. Cleared on register
read.</description>
              <bitRange>[25:25]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>CONTROL</name>
          <addressOffset>0x18</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>abort</name>
              <description>Write `1` to this field to both initiate and acknowledge an abort. Empties both
FIFOs, asserts `aborting`, and prevents an interrupt from being generated by an
incoming abort request. New reads &amp; writes are ignored until `aborted` is
asserted from the peer.</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>DONE</name>
          <addressOffset>0x1C</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>done</name>
              <description>Writing a `1` to this field indicates to the corresponding peer that a full
packet is done loading. There is no need to clear this register after writing.</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>LOOPBACK</name>
          <addressOffset>0x20</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>loopback</name>
              <description>Writing a `1` to this field indicates that the mailbox should loopback to the
local client. `0` connects it to the external core.</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
